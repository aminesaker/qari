{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "whisper.rn": [
        "./node_modules/whisper.rn/lib/typescript/index.d.ts"
      ],
      "whisper.rn/*": [
        "./node_modules/whisper.rn/lib/typescript/*"
      ]
    }
  },
  "//": "whisper.rn n'expose pas ses types via \"exports\" pour le bundler : alias r\u00e9serv\u00e9s \u00e0 tsc (Metro lit tsconfig.json)."
}